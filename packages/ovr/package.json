{
	"name": "ovr",
	"description": "Web apps anyone can use. Each route serves people a page and agents Markdown and MCP tools, with forms, Postgres, and passkey sign-in built in.",
	"version": "6.2.5",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ovrjs/ovr.git"
	},
	"author": {
		"name": "Ross Robino",
		"url": "https://robino.dev"
	},
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": {
			"default": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"check": "tsc",
		"dev": "node scripts/client.js --watch",
		"build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && node scripts/client.js && tsc -p tsconfig.build.json && cp ../../LICENSE.md dist"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@electric-sql/pglite-socket": "^0.2.13",
		"@types/pg": "^8.23.1",
		"pg": "^8.23.1",
		"rolldown": "^1.2.1"
	}
}
